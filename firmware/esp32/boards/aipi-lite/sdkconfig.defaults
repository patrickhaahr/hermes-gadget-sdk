# AIPI Lite: ESP32-S3 (8 MB octal PSRAM), 16 MB flash, 128x128 ST7789-family SPI panel,
# single ES8311 codec (speaker DAC + mic ADC), boot + power buttons, battery gauge.
CONFIG_IDF_TARGET="esp32s3"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_HG_BOARD_AIPI_LITE=y
