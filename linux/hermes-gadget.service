[Unit]
Description=Hermes Gadget device
Wants=network-online.target
After=network-online.target
# A release that crashes at startup is retried a few times, then left for a person.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hermes-gadget
Group=hermes-gadget
StateDirectory=hermes-gadget
StateDirectoryMode=0700
WorkingDirectory=/opt/hermes-gadget/current
Environment=HGSIM_LIBRARY=/opt/hermes-gadget/current/libhgsim.so
ExecStart=/opt/hermes-gadget/current/venv/bin/hermes-gadget linux --state-dir /var/lib/hermes-gadget run --config /etc/hermes-gadget/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
